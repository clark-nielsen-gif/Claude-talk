; Danish texts for Tauri's own installer messages (Tauri ships none).
LangString addOrReinstall ${LANG_DANISH} "Tilføj eller installer igen"
LangString alreadyInstalled ${LANG_DANISH} "Allerede installeret"
LangString alreadyInstalledLong ${LANG_DANISH} "${PRODUCTNAME} ${VERSION} er allerede installeret. Vælg, hvad du vil gøre, og tryk Næste."
LangString appRunning ${LANG_DANISH} "${PRODUCTNAME} kører stadig. Luk programmet (højreklik på ikonet ved uret, og vælg Luk Claude Talk), og prøv igen."
LangString noPermissionToCloseApp ${LANG_DANISH} "${PRODUCTNAME} kunne ikke lukkes. Luk programmet (højreklik på ikonet ved uret, og vælg Luk Claude Talk), og prøv igen."
LangString appRunningOkKill ${LANG_DANISH} "${PRODUCTNAME} kører stadig.$\nTryk OK for at lukke programmet og fortsætte."
LangString chooseMaintenanceOption ${LANG_DANISH} "Vælg, hvad du vil gøre."
LangString chooseHowToInstall ${LANG_DANISH} "Vælg, hvordan ${PRODUCTNAME} skal installeres."
LangString createDesktop ${LANG_DANISH} "Lav en genvej på skrivebordet"
LangString dontUninstall ${LANG_DANISH} "Afinstaller ikke"
LangString dontUninstallDowngrade ${LANG_DANISH} "Afinstaller ikke (en ældre version kan ikke installeres uden at afinstallere først)"
LangString failedToKillApp ${LANG_DANISH} "${PRODUCTNAME} kunne ikke lukkes. Luk programmet (højreklik på ikonet ved uret, og vælg Luk Claude Talk), og prøv igen."
LangString newerVersionInstalled ${LANG_DANISH} "En nyere version af ${PRODUCTNAME} er allerede installeret. Det anbefales ikke at installere en ældre version. Vil du alligevel, så afinstaller først den nuværende version. Vælg, hvad du vil gøre, og tryk Næste."
LangString older ${LANG_DANISH} "ældre"
LangString olderOrUnknownVersionInstalled ${LANG_DANISH} "En $R4 version af ${PRODUCTNAME} er installeret. Det anbefales at afinstallere den først. Vælg, hvad du vil gøre, og tryk Næste."
LangString silentDowngrades ${LANG_DANISH} "En ældre version kan ikke installeres lydløst. Brug den almindelige installer i stedet.$\n"
LangString unableToUninstall ${LANG_DANISH} "Afinstallationen lykkedes ikke."
LangString uninstallApp ${LANG_DANISH} "Afinstaller ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_DANISH} "Afinstaller før installation"
LangString unknown ${LANG_DANISH} "ukendt"
LangString deleteAppData ${LANG_DANISH} "Slet også indstillinger og Claude-login"
LangString installingWebview2 ${LANG_DANISH} "Installerer WebView2 …"
LangString webview2AbortError ${LANG_DANISH} "WebView2 kunne ikke installeres. Claude Talk kan ikke køre uden. Prøv at starte installationen igen."
LangString webview2DownloadError ${LANG_DANISH} "Fejl: WebView2 kunne ikke hentes - $0"
LangString webview2DownloadSuccess ${LANG_DANISH} "WebView2-installationen er hentet"
LangString webview2Downloading ${LANG_DANISH} "Henter WebView2-installationen …"
LangString webview2InstallError ${LANG_DANISH} "Fejl: WebView2 kunne ikke installeres (kode $1)"
LangString webview2InstallSuccess ${LANG_DANISH} "WebView2 er installeret"
